@using AnthonyB_Portfolio.Core.Entities
@using AnthonyB_Portfolio.Web.Components.Shared
@inject Services.PreloadService PreloadService

@page "/projets"

<PageTitle>Projets Notables @SiteSettings.TitleSuffix</PageTitle>

<div id="projects-page">
    <div id="projects-grid-container" class="@(isDetailsActive ? "shifted" : "")">
        <MainTitle>Projets Notables</MainTitle>
        @if (projects != null && projects.Any())
        {
            <div id="projects-grid">
                @foreach (Project project in projects)
                {
                    <div class="hover-button-container">
                        <article @onclick="() => ShowProjectDetails(project)">
                            <div class="project-grid-descr">
                                <h3>@project.Title</h3>
                                <p>@project.Description</p>
                            </div>

                            <div class="project-grid-skills">
                                @foreach (ProjectSkill skill in project.Skills)
                                {
                                    <SkillBadge Name="@skill.Skill.Name" IsHighlighted="@skill.IsHighlighted" />
                                }
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
        else if (fetchError)
        {
            <ErrorMessage>
                Erreur lors du chargement des projets. Veuillez réessayer plus tard.
            </ErrorMessage>
        }
        else
        {
            // Placeholder layout
            <div id="projects-grid">
                @for (int i = 1; i <= 4; i++)
                {
                    <div class="hover-button-container">
                        <article class="loading-placeholder">
                            <div class="project-grid-descr">
                                <h3>&nbsp;</h3>
                                <p>&nbsp;<br />&nbsp;</p>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>

    <div id="project-details-container" class="@(isDetailsActive ? "active" : "")">
        @if (selectedProject != null)
        {
            <button id="back-btn" @onclick="CloseDetails">
                ← Retour
            </button>

            <div id="project-details">
                <header>
                    <div id="project-title-and-link">
                        <h3>@selectedProject.Title</h3>

                        @if (!string.IsNullOrEmpty(selectedProject.Url))
                        {
                            <a href="@selectedProject.Url" target="_blank" >@selectedProject.Url</a>
                        }
                    </div>

                    <p>@selectedProject.Description</p>
                    
                    <div id="project-details-skills">
                        @foreach (ProjectSkill skill in selectedProject.Skills)
                        {
                            <SkillBadge Name="@skill.Skill.Name" IsHighlighted="@skill.IsHighlighted" />
                        }
                    </div>
                </header>

                <div id="project-details-description">
                    <ul>
                        @foreach (ProjectDetail detail in selectedProject.Details)
                        {
                            <li>@detail.Description</li>
                        }
                    </ul>

                    @if (selectedProject.Screenshots.Any())
                    {
                        <aside>
                            @foreach (ProjectScreenshot screenshot in selectedProject.Screenshots)
                            {
                                <img alt="screenshot-@screenshot.DisplayOrder" src="@screenshot.Url"/>
                            }
                        </aside>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<Project>? projects;
    private Project? selectedProject;
    private Project? queuedProject;
    private bool fetchError = false;
    private bool isDetailsActive = false;

    // Fetch the projects upon loading 
    protected override async Task OnInitializedAsync()
    {
        try 
        {
            // Fetch the projects from the API
            projects = await PreloadService.GetProjectsAsync();

            // No projects found
            if (projects == null)
            {
                // Error fectching projects
                fetchError = true;
            }
        }
        catch (Exception err)
        {
            // Error fetching projects
            fetchError = true;
            Console.WriteLine($"Error fetching projects: {err.Message}");
        }
    }

    // Select the project when the card is clicked on
    private void ShowProjectDetails(Project project)
    {
        // The previous project has been cleared
        if (selectedProject == null)
        {
            selectedProject = project;
            isDetailsActive = true;
        }
        // The previous project is still sliding out
        else
        {
            // Queue the clicked project
            queuedProject = project;
        }

    }

    // Close the details view
    private async Task CloseDetails()
    {   
        // Trigger panel slide out transition
        isDetailsActive = false;

        // CSS transition
        await Task.Delay(450);

        // Clear the project
        selectedProject = null;

        // Display the queued project if one has been clicked
        if (queuedProject != null)
        {
            ShowProjectDetails(queuedProject);
            queuedProject = null;
        }
    }
}