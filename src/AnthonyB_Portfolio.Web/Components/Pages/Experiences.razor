@using AnthonyB_Portfolio.Core.Entities
@using AnthonyB_Portfolio.Web.Components.Shared
@inject HttpClient Http

@page "/parcours"

<PageTitle>Parcours Professionnel @SiteSettings.TitleSuffix</PageTitle>

<div id="experiences-page">
    <MainTitle>Parcours Professionnel</MainTitle>

    @if (experiences != null && experiences.Any())
    {
        <div id="experiences-timeline">
            @foreach (Experience exp in experiences)
            {
                bool isExpanded = selectedExp == exp;

                <article class="@(isExpanded ? "active" : "")" @onclick="() => Expand(exp)">
                    <div class="timeline-dot"></div>
                    
                    <div class="hover-button-container">
                        <div class="experience">
                            <header>
                                <div>
                                    <h3>@exp.Title</h3>
                                    <h4>@exp.Organization</h4>
                                </div>
                                <span>@exp.StartTime.ToShortDateString() - @(exp.EndDate?.ToShortDateString() ?? "Présent")</span>
                            </header>

                            <div class="experience-details-container">
                                <div class="experience-details">
                                    <ul>
                                        @foreach (Responsibility responsibility in exp.Responsibilities)
                                        {
                                            <li>@responsibility.Description</li>
                                        }
                                    </ul>
                                    <aside>
                                        @foreach (ExperienceSkill skill in exp.Skills)
                                        {
                                            <SkillBadge Name="@skill.Skill.Name" IsHighlighted="@skill.IsHighlighted" />
                                        }
                                    </aside>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else if (fetchError)
    {
        <ErrorMessage>
            Erreur lors du chargement des expériences. Veuillez réessayer plus tard.
        </ErrorMessage>
    }
    else
    {
        // Placholder layout
        <div id="experiences-timeline">
            @for (int i = 1; i <= 8; i++)
            {
                <article class="loading-placeholder">
                    <div class="timeline-dot"></div>
                    
                    <div class="hover-button-container">
                        <div class="experience">
                            <header>
                                <div>
                                    <h3>&nbsp;</h3>
                                    <h4>&nbsp;</h4>
                                </div>
                            </header>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    private List<Experience>? experiences;
    private Experience? selectedExp;
    private bool fetchError = false;

    // Fetch the experiences upon loading
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Fetch the experiences from the API
            experiences = await Http.GetFromJsonAsync<List<Experience>>("experiences");

            // Experiences are found
            if (experiences != null)
            {
                // Sort the experiences
                experiences = experiences.OrderByDescending(e => e.StartTime).ToList();

                // Sort the collections
                foreach (Experience e in experiences)
                {
                    e.Responsibilities = e.Responsibilities.OrderBy(r => r.DisplayOrder).ToList();
                    e.Skills = e.Skills.OrderBy(s => s.DisplayOrder).ToList();
                }
            }
            // No experiences found
            else
            {
                // Error fetching experiences
                fetchError = true;
            }
        }
        catch (Exception err)
        {
            // Error fetching experiences
            fetchError = true;
            Console.WriteLine($"Error fetch experiences: {err.Message}");
        }
    }

    // Expand the experience
    private void Expand(Experience exp)
    {
        selectedExp = exp;
    }
}