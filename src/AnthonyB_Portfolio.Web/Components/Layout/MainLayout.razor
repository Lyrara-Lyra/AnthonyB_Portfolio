@inherits LayoutComponentBase
@inject Services.PreloadService PreloadService
@inject Services.ThemeService ThemeService
@implements IDisposable

<HeadContent>
    <link rel="icon" type="image/png" href="/favicon-@(string.IsNullOrEmpty(ThemeService.CurrentTheme) ? "light" : ThemeService.CurrentTheme).png" />
</HeadContent>

<div id="main-layout" class="@(_isSidebarOpen ? "sidebar-open" : "")" data-theme="@ThemeService.CurrentTheme">
    <div id="sidebar-overlay" @onclick="ToggleSidebar"></div>
    
    <button id="sidebar-toggle-fixed" @onclick="ToggleSidebar">
            <span class="icon">☰</span>
    </button>

    <aside>
        <Sidebar />

        <button id="sidebar-toggle" @onclick="ToggleSidebar">
            <span class="icon">☰</span><span class="text">Menu</span>
        </button>
    </aside>

    <main>
        @Body
    </main>
</div>

@code {
    private bool _isSidebarOpen = false;

    private void ToggleSidebar()
    {
        _isSidebarOpen = !_isSidebarOpen;
    }

    protected override void OnInitialized()
    {
        // Initialize data caching
        PreloadService.InitializePreload();

        // Subscribe to theme changes
        ThemeService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        // Unsubscribe to theme changes
        ThemeService.OnChange -= StateHasChanged;
    }

    // Loads the saved theme when first rendered
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitializeAsync();
        }
    }
}